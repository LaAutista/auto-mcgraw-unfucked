{
  "manifest_version": 3,
  "name": "Auto-McGraw Smartbook",
  "version": "2.9",
  "description": "Transfers a question from MHEducation's Smartbook to AI assistants and then uses their response to auto‐select an answer.",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://learning.mheducation.com/*",
    "https://ezto.mheducation.com/*",
    "https://connect.mheducation.com/*",
    "https://newconnect.mheducation.com/*",
    "https://author.muzzylane.com/*",
    "https://sfc.muzzylane.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://deepseek.chat/*"
  ],
  "background": {
    "scripts": ["background/background.js"],
    "service_worker": "background/background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "auto-mcgraw-unfucked@laautista.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "icons": {
    "512": "assets/icon.png"
  },
  "action": {
    "default_popup": "popup/settings.html",
    "default_icon": "assets/icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://learning.mheducation.com/static/awd/*"],
      "js": ["content-scripts/mheducation.js"]
    },
    {
      "matches": ["https://ezto.mheducation.com/*"],
      "js": ["content-scripts/ezto-mheducation.js"]
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content-scripts/chatgpt.js"]
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content-scripts/gemini.js"]
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content-scripts/deepseek.js"]
    },
    {
      "matches": ["https://sfc.muzzylane.com/*"],
      "js": ["content-scripts/muzzylane.js"],
      "all_frames": true
    }
  ]
}
